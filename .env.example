# GhostSignal Configuration & Environment Variables

# Server
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Direct Mobile SMS Text Gateway (Twilio)
# Set these to send OTP codes directly to mobile phones via cellular SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Alternative SMS Gateway for India (Fast2SMS)
FAST2SMS_API_KEY=

# OTP & Privacy Settings
# Set to false so OTP is never shown locally on screen, but sent only via SMS text to phone
SHOW_DEV_OTP_IN_RESPONSE=false
OTP_EXPIRY_SECONDS=300

# Whisper On-Device Speech-to-Text
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
